# 🔥 Firebase Configuration for GitHub Pages
# 
# Get these values from Firebase Console → Project Settings → Your apps section
# No custom domain needed - works with svedriall.github.io

# 📋 Copy these from your Firebase project:
VITE_FIREBASE_API_KEY=AIzaSy...your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-name.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-name
VITE_FIREBASE_STORAGE_BUCKET=your-project-name.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# ✅ These work perfectly with GitHub Pages - no custom domain needed!
# 🌐 Your site: https://svedriall.github.io/German-Article-Trainer/